01100893    // addi  x17, x0, 17       ; Not Taken

//=====================================================

// BGE (Taken)
// x1(-2147483648) >= x2(-2147483648) → Taken
0020D463    // bge   x1, x2, PASS

//성공시 reg[18]=18, 실패시 reg[18]=99
06300913    // addi  x18, x0, 99
01200913    // addi  x18, x0, 18       ; PASS

// BGE (Not Taken)
// x1(-2147483648) >= x3(1) → False
0030D463    // bge   x1, x3, PASS

//성공시 reg[19]=19, 실패시 reg[19]=x
01300993    // addi  x19, x0, 19       ; Not Taken

//=====================================================

// BGEU (Taken)
// x1(2147483648) >= x3(1) → Taken
0030F463    // bgeu  x1, x3, PASS

