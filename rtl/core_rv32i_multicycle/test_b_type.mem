//=====================================================
// Register Initialize
//=====================================================
800000B7    // lui   x1, 0x80000        ; x1 = 0x80000000
80000137    // lui   x2, 0x80000        ; x2 = 0x80000000
00100193    // addi  x3, x0, 1          ; x3 = 1

// BEQ (Taken)
00208463    // beq   x1, x2, PASS

//성공시 reg[10]=10, 실패시 reg[10]=99
06300513    // addi  x10, x0, 99       ; Not Taken
00A00513    // addi  x10, x0, 10       ; PASS (Taken)

// BEQ (Not Taken) with JAL
00308463    // beq   x1, x3, PASS

//성공시 reg[11]=11, 실패시 reg[11]=x
00B00593    // addi  x11, x0, 11       ; Not Taken(정상)

//=====================================================

// BNE (Taken)
00309463    // bne   x1, x3, PASS

//성공시 reg[12]=12, 실패시 reg[12]=99
06300613    // addi  x12, x0, 99       ; Not Taken
00C00613    // addi  x12, x0, 12       ; PASS (Taken)

// BNE (Not Taken)
00209463    // bne   x1, x2, PASS

//성공시 reg[13]=13, 실패시 reg[13]=x
00D00693    // addi  x13, x0, 13       ; Not Taken (정상)

//=====================================================

// BLT (Taken)
// x1(-2147483648) < x3(1) → Taken
0030C463    // blt   x1, x3, PASS

//성공시 reg[14]=14, 실패시 reg[14]=99
06300713    // addi  x14, x0, 99
00E00713    // addi  x14, x0, 14       ; PASS

// BLT (Not Taken)
// x1(-2147483648) < x2(-2147483648) → False
0020C463    // blt   x1, x2, PASS

//성공시 reg[15]=15, 실패시 reg[15]=x
00F00793    // addi  x15, x0, 15       ; Not Taken

//=====================================================

// BLTU (Taken)
// x1(2147483648) >= x3(1) → False
// unsigned : x1 < x3 → False (Not Taken)
// x3 < x1 이므로 Taken을 위해 x3, x1 비교
0011E463    // bltu  x3, x1, PASS

//성공시 reg[16]=16, 실패시 reg[16]=99
06300813    // addi  x16, x0, 99
01000813    // addi  x16, x0, 16       ; PASS

// BLTU (Not Taken)
// x1(2147483648) < x2(2147483648) → False
0020E463    // bltu  x1, x2, PASS

