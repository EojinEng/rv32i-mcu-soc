00A0E493    // ori   x9, x1, 10      ; x9 = 5 | 10 = 15
00C0F513    // andi  x10,x1, 12      ; x10 = 5 & 12 = 4
00209593    // slli  x11,x1, 2       ; x11 = 5 << 2 = 20
