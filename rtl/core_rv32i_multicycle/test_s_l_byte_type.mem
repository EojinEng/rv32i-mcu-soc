0F100093    // addi  x1, x0, 0x0F1      ; x1 = 0x000000F1
0F200113    // addi  x2, x0, 0x0F2      ; x2 = 0x000000F2
0F300193    // addi  x3, x0, 0x0F3      ; x3 = 0x000000F3
0F400213    // addi  x4, x0, 0x0F4      ; x4 = 0x000000F4

00100023    // sb    x1, 0(x0)          ; mem[0][7:0]   = 0xF1
002000A3    // sb    x2, 1(x0)          ; mem[0][15:8]  = 0xF2
00300123    // sb    x3, 2(x0)          ; mem[0][23:16] = 0xF3 
004001A3    // sb    x4, 3(x0)          ; mem[0][31:24] = 0xF4  ; mem[0] = 0xF4F3F2F1 

00000283    // lb    x5, 0(x0)          ; x5  = 0xFFFFFFF1 (Sign Extend)
00100303    // lb    x6, 1(x0)          ; x6  = 0xFFFFFFF2 (Sign Extend)
00200383    // lb    x7, 2(x0)          ; x7  = 0xFFFFFFF3 (Sign Extend)
00300403    // lb    x8, 3(x0)          ; x8  = 0xFFFFFFF4 (Sign Extend)

00004483    // lbu   x9, 0(x0)          ; x9  = 0x000000F1 (Zero Extend)
00104503    // lbu   x10, 1(x0)         ; x10 = 0x000000F2 (Zero Extend)
00204583    // lbu   x11, 2(x0)         ; x11 = 0x000000F3 (Zero Extend)
00304603    // lbu   x12, 3(x0)         ; x12 = 0x000000F4 (Zero Extend)

00000013    // nop
00000013    // nop
00000013    // nop